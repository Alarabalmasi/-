# عام
APP_TIMEZONE=Asia/Riyadh
SYNC_LOOKBACK_HOURS=48
HTTP_TIMEOUT_MS=20000
HTTP_RETRY_COUNT=3
LOCK_STALE_MS=3600000
GOOGLE_SHEET_ID=1GtRjDlzEBy62EOjMBV9Zeyuj5vS-aR_hxlPtK2M_e1w

# Google OAuth — يمكن استخدام نفس العميل/refresh token إذا مُنح جميع النطاقات المطلوبة
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# Google Ads
GOOGLE_ADS_CUSTOMER_ID=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
GOOGLE_ADS_API_VERSION=v25
# اختياري للتوافق مع حسابات/مشاريع قديمة فقط؛ اعتباراً من 2026-09-09 أصبح غير مطلوب للحسابات المنقولة.
GOOGLE_ADS_DEVELOPER_TOKEN=

# Search Console
SEARCH_CONSOLE_SITE_URL=https://alarabalmasi.com/
SEARCH_CONSOLE_ROW_LIMIT=25000

# Zid OAuth Authorization + direct store access
ZID_AUTHORIZATION_TOKEN=
ZID_MANAGER_TOKEN=
ZID_STORE_ID=
ZID_REDIRECT_URI=
ZID_BASE_URL=https://api.zid.sa/v1

# WhatsApp Business Platform
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_WABA_ID=
WHATSAPP_GRAPH_VERSION=
# للتحقق من webhook محلياً (اختياري لكن موصى به)
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
