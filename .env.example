# الجدولة المحلية (cron expressions للتوثيق/الاستخدام مع مجدول خارجي لاحقاً)
SCHEDULE_ZID=0 * * * *
SCHEDULE_WHATSAPP=5 * * * *
SCHEDULE_GOOGLE_ADS=15 4 * * *
SCHEDULE_SEARCH_CONSOLE=30 4 * * *
